pipeline {
    agent any

    stages {

        stage('Install Dependencies') {
            steps {
                dir('demo-frontend') {
                    bat 'npm install'
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('demo-frontend') {
                    bat 'npm test -- --watchAll=false --passWithNoTests'
                }
            }
        }

        stage('Build Frontend') {
            steps {
                dir('demo-frontend') {
                    bat 'npm run build'
                }
            }
        }
    }

    post {

        success {
            echo 'Frontend pipeline completed successfully!'
        }

        failure {
            echo 'Frontend pipeline failed!'

            mail(
                subject: "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
Hello,

The demo frontend Jenkins pipeline failed.

Job: ${env.JOB_NAME}
Build Number: ${env.BUILD_NUMBER}
Status: FAILURE

Please check the Jenkins console output for the error.

Build URL:
${env.BUILD_URL}

Regards,
Jenkins
""",
                to: "lasyav7104@gmail.com"
            )
        }
    }
}