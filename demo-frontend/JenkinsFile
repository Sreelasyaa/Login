pipeline {
    agent any

    stages {

        stage('Install Dependencies') {
            steps {
                dir('demo-frontend') {
                    bat 'npm install'
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('demo-frontend') {
                    bat 'npm test -- --watchAll=false'
                }
            }
        }

        stage('Build Frontend') {
            steps {
                dir('demo-frontend') {
                    bat 'npm run build'
                }
            }
        }
    }

    post {
        success {
            echo 'Frontend pipeline completed successfully!'
        }

        failure {
            echo 'Frontend pipeline failed!'
        }
    }
}