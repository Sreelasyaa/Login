pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'npm install'
            }
        }

        stage('Run Tests') {
            steps {
                bat 'npm test -- --watchAll=false'
            }
        }

        stage('Build Frontend') {
            steps {
                bat 'npm run build'
            }
        }
    }

    post {
        success {
            echo 'Frontend pipeline completed successfully!'
        }

        failure {
            echo 'Frontend pipeline failed!'
        }
    }
}